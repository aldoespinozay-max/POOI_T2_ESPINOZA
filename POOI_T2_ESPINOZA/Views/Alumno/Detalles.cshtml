@model POOI_T2_ESPINOZA.Models.Alumno

@{
    ViewBag.Title = "Detalles";
}

<h2>Detalles del Alumno</h2>

<div>
    <dl class="dl-horizontal">
        <dt>
            DNI
        </dt>
        <dd>
            @Model.dni
        </dd>

        <dt>
            Nombres
        </dt>
        <dd>
            @Model.nombres
        </dd>

        <dt>
            Apellidos
        </dt>
        <dd>
            @Model.apellidos
        </dd>

        <dt>
            Carrera
        </dt>
        <dd>
            @Model.carrera
        </dd>

        <dt>
            Ciclo
        </dt>
        <dd>
            @Model.ciclo
        </dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Regresar", "Index")
</p>