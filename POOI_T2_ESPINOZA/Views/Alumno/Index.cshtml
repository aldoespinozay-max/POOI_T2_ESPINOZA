@model List<POOI_T2_ESPINOZA.Models.Alumno>

@{
    ViewBag.Title = "Index";
}

<h2>Lista de Alumnos</h2>

@if (ViewBag.Mensaje != null)
{
    <div id="mensaje" class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

<p>
    @Html.ActionLink("Agregar Alumno", "Agregar")
</p>

<p>
    @Html.ActionLink("Serializar", "Serializar", null, new { @class = "btn btn-success" })
</p>

<table class="table">
    <tr>
        <th>DNI</th>
        <th>Nombres</th>
        <th>Apellidos</th>
        <th>Carrera</th>
        <th>Ciclo</th>
        <th>Acciones</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.dni</td>
            <td>@item.nombres</td>
            <td>@item.apellidos</td>
            <td>@item.carrera</td>
            <td>@item.ciclo</td>
            <td>
                @Html.ActionLink("Detalles", "Detalles", new { dni = item.dni })
                |
                @Html.ActionLink("Actualizar", "Actualizar", new { dni = item.dni })
                |
                @Html.ActionLink("Eliminar", "Eliminar", new { dni = item.dni })
            </td>
        </tr>
    }
</table>

@if (ViewBag.Mensaje != null)
{
    <script>
                setTimeout(function () {
                    var mensaje = document.getElementById("mensaje");

                    if (mensaje != null) {
                        mensaje.style.display = "none";
                    }
                }, 5000);
    </script>
}